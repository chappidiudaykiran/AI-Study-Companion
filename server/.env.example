PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/ai-study-companion
JWT_SECRET=change-me-day0
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-key-here
# AI provider switch: gemini | inception
AI_PROVIDER=gemini
# InceptionLabs (mercury) — set locally in server/.env, never commit
INCEPTION_API_KEY=your-inception-key-here
INCEPTION_MODEL=mercury-2.5
INCEPTION_REASONING=low
AI_TIMEOUT_MS=30000
INCEPTION_TIMEOUT_MS=30000
# Mail for forgot-password (e.g. Gmail App Password). If unset, links print to server console (dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=AI Study Companion <you@example.com>
MAX_PDF_MB=15
